# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Configuration
GOOGLE_SERVICE_ACCOUNT=base64_encoded_service_account_json
GOOGLE_APPLICATION_CREDENTIALS=path_to_service_account.json

# WhatsApp Configuration
WHATSAPP_BOT_NUMBER=your_whatsapp_number
WHATSAPP_AUTH_STATE=base64_encoded_auth_state_json

# Google Sheets Configuration
MASTER_SHEET_ID=your_master_sheet_id
DRIVE_FOLDER_ID=your_drive_folder_id
USER_SHEETS_SHEET_ID=your_user_sheets_sheet_id

# Application Settings
NODE_ENV=production
PORT=3000 